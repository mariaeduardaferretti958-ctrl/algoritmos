programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade

    nome = "ferretti"
    pontos = 1500
    idade = 16
    escreva("Olá, mundo! \n")
    escreva(nome, "ferretti tem " , idade,"de idade\n")
    escreva(nome," tem " ,pontos, " cestas, no basquete, incrivel! com ", idade," anos de idade ")

  }
}
