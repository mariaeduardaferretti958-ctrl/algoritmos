programa
{
	funcao inicio()
	{
		// Declaração de variável (cadeia de caracteres para tratar a senha como texto/código)
		cadeia senha

		// Entrada de dados
		escreva("Digite a senha de acesso: ")
		leia(senha)

		// Verificação da senha
		se (senha == "1234")
		{
			escreva("\n[+] Sistema Desbloqueado\n")
		}
			escreva("\n[-] Senha Incorreta - Invasor Detectado\n")
		}
	}
}