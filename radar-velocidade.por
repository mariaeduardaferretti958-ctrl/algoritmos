programa
{
	funcao inicio()
	{
		// Declaração de variável
		real velocidade

		// Entrada de dados
		escreva("Digite a velocidade do veículo (km/h): ")
		leia(velocidade)

		// Verificação do limite de velocidade
		se (velocidade > 80.0)
		{
			escreva("\n[!] Veículo Multado\n")
		}
			escreva("\n[V] Velocidade Permitida\n")
		}
	}
}